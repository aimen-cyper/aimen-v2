# ==========================================================
#  ملف إعدادات البيئة — انسخه إلى .env ثم املأ القيم
#  ⚠️ لا ترفع ملف .env إلى Git أبداً
#  🔒 اضبط صلاحيته: chmod 600 .env   (يفحصه البوت ويضبطه عند الإقلاع، ويفحصه
#     الأمر: python -m scripts.security_check)
# ==========================================================

# توكن البوت من BotFather (مطلوب لتشغيل البوت، غير مطلوب لتهيئة قاعدة البيانات)
# الصيغة: 123456789:AA... بلا مسافات أو علامات اقتباس (تُفحص عند التحميل)
BOT_TOKEN=

# معرفات تيليجرام لأصحاب صلاحية الأدمن الأعلى، مفصولة بفواصل
# تُستخدم لزرع أول حساب إداري وللطوارئ فقط — معرّفات أشخاص موجبة (ليست مجموعات)
SUPER_ADMIN_IDS=

# مفتاح تشفير مفاتيح المزودين (Fernet)
# ولّده بالأمر: python -m scripts.init_db --gen-key
ENCRYPTION_KEY=

# مسار ملف قاعدة البيانات
DATABASE_PATH=data/smm_bot.db

# إعدادات السجلات: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# مجلد النسخ الاحتياطية
BACKUP_DIR=backups

# المنطقة الزمنية المستخدمة في العرض (التخزين دائماً UTC)
TIMEZONE=Asia/Aden

# قناة أو مجموعة لاستقبال تنبيهات النظام والمستخدمين الجدد (اختياري). الصيغ المقبولة:
#   -1001234567890 (قناة/مجموعة، رقم سالب يبدأ بـ -100) · @channel_username · https://t.me/channel_username
# القناة الخاصة: استعمل الرقم -100… (وليس رابط الدعوة t.me/+...) وأضِف البوت مشرفاً بصلاحية النشر.
# يمكن أيضاً ضبطها من البوت: لوحة التحكم ← ⚙️ الإعدادات (يتقدم الإعداد على هذا المتغير).
ADMIN_ALERT_CHAT_ID=

# قناة خاصة لحفظ النسخ الاحتياطية خارج السيرفر (اختياري) — للنسخ فقط، لا تُنشر فيها أي رسائل أخرى.
# نفس صيغ ADMIN_ALERT_CHAT_ID. خطأ «Chat not found» يعني معرّفاً خاطئاً أو بوتاً ليس مشرفاً في القناة.
BACKUP_CHANNEL_ID=

# منفذ خادم الصحة (اختياري). تضبطه استضافات مثل Render تلقائياً؛ عند وجوده يفتح البوت منفذ HTTP خفيفاً
# (GET /health) ليُعتبر الـWeb Service حيّاً. اتركه فارغاً محلياً.
PORT=
